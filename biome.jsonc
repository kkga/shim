{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {},
  "extends": ["ultracite/core", "ultracite/next"],
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useConst": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "interface" }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/(docs)/components/**/_content/**",
        "app/(docs)/**/demos/**"
      ],
      "linter": {
        "rules": { "style": { "noMagicNumbers": "off" } }
      }
    },
    {
      "includes": ["shim-ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["./**"], "message": "Use alias imports." },
                  {
                    "group": ["../**"],
                    "message": "Avoid parent relative imports."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
