{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {},
  "extends": ["ultracite/core", "ultracite/next"],
  "linter": {
    "rules": {
      "style": {
        "useConst": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/(docs)/components/**/_content/**",
        "app/(docs)/**/demos/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
